# Local Postgres (Homebrew postgresql@14 on Shahid’s Mac)
DATABASE_URL=postgresql://shahidsuri@localhost:5432/samra_clinic

# Cookie / token signing (generate a long random string)
SESSION_SECRET=change-me-to-a-long-random-secret-for-local-dev

# App URL
APP_URL=http://localhost:3001

# Optional: Stripe test mode (omit to use mocked payments)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional: WhatsApp (omit to mock)
# WHATSAPP_PROVIDER=meta
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Or: WHATSAPP_PROVIDER=twilio + TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN + TWILIO_WHATSAPP_FROM

# Optional: S3-compatible storage (omit to use .data/uploads)
# S3_ENDPOINT=
# S3_REGION=eu-west-2
# S3_BUCKET=samra-clinic
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
