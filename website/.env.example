# Required for the contact form to deliver email (Resend).
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives website enquiries (defaults to hello@samraskinaesthetics.com).
CONTACT_TO_EMAIL=hello@samraskinaesthetics.com

# Must be a verified sender on your Resend account / domain.
# Until the domain is verified, Resend’s test sender works for limited testing:
# CONTACT_FROM_EMAIL=Samra Website <onboarding@resend.dev>
CONTACT_FROM_EMAIL=Samra Skin & Aesthetics <hello@samraskinaesthetics.com>
